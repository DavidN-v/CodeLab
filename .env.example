# Copia este archivo como .env y ajusta los valores. El archivo .env no se versiona.

# --- PostgreSQL ---
POSTGRES_DB=forja
POSTGRES_USER=forja
# Obligatoria. Usa un valor propio; no reutilices este texto.
POSTGRES_PASSWORD=

# --- Puertos publicados en tu máquina ---
DB_PORT=5432
BACKEND_PORT=8080
FRONTEND_PORT=4200

# --- Backend ---
# Obligatoria. Firma los tokens de sesión: un texto aleatorio de al menos 32
# caracteres. Por ejemplo, la salida de `openssl rand -base64 48`.
JWT_SECRET=
# Orígenes (separados por comas) autorizados a llamar a la API desde un navegador.
CORS_ALLOWED_ORIGINS=http://localhost:4200
LOG_LEVEL=INFO
# Swagger UI y /v3/api-docs. Ponlo a false en entornos expuestos a internet.
API_DOCS_ENABLED=true

# --- Tutor con IA (opcional) ---
# Con una clave de la API de Anthropic se activan los botones del tutor: otra
# explicación de la lección, pistas cuando un programa falla y revisión de
# soluciones. Sin clave, la plataforma funciona igual pero sin tutor.
ANTHROPIC_API_KEY=
# Modelo de Claude que responde.
TUTOR_MODEL=claude-opus-5-5

# --- Code-runner ---
# Programas que se pueden ejecutar a la vez; cada uno usa hasta 512 MB.
MAX_CONCURRENT_EXECUTIONS=2
