# Copia este archivo como .env y ajusta los valores. El archivo .env no se versiona.

# --- PostgreSQL ---
POSTGRES_DB=forja
POSTGRES_USER=forja
# Obligatoria. Usa un valor propio; no reutilices este texto.
POSTGRES_PASSWORD=

# --- Puertos publicados en tu máquina ---
DB_PORT=5432
BACKEND_PORT=8080
FRONTEND_PORT=4200

# --- Backend ---
# Orígenes (separados por comas) autorizados a llamar a la API desde un navegador.
CORS_ALLOWED_ORIGINS=http://localhost:4200
LOG_LEVEL=INFO
# Swagger UI y /v3/api-docs. Ponlo a false en entornos expuestos a internet.
API_DOCS_ENABLED=true
