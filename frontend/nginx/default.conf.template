server {
    listen 8080;
    server_name _;

    root /usr/share/nginx/html;
    index index.html;

    add_header X-Content-Type-Options "nosniff" always;
    add_header X-Frame-Options "DENY" always;
    add_header Referrer-Policy "strict-origin-when-cross-origin" always;

    # The browser only ever talks to this origin; the API stays behind it.
    location /api/ {
        proxy_pass ${API_UPSTREAM};
        proxy_http_version 1.1;
        proxy_set_header Host $host;
        proxy_set_header X-Real-IP $remote_addr;
        proxy_set_header X-Forwarded-For $proxy_add_x_forwarded_for;
        proxy_set_header X-Forwarded-Proto $scheme;
        # Grading every test case and asking the AI tutor can take well over
        # nginx's default 60 s; the backend bounds both on its own.
        proxy_read_timeout 150s;
        proxy_send_timeout 150s;
    }

    # `expires` is used instead of add_header for caching: an add_header inside a
    # location would discard the security headers declared above.

    # Build output is content-hashed, so it can be cached for a long time.
    location ~* \.(?:js|css|woff2?)$ {
        expires 1y;
        try_files $uri =404;
    }

    # Client-side routes fall back to the application shell, which is never cached.
    location / {
        expires -1;
        try_files $uri $uri/ /index.html;
    }
}
